{
  "name": "@crostream/widget-runtime",
  "version": "0.1.1",
  "description": "The CroStream widget runtime: the sandboxed frame, the host library, the renderer, the sl API model and the checks for .csw widgets.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crostream/widget-runtime.git"
  },
  "homepage": "https://github.com/crostream/widget-runtime#readme",
  "bugs": "https://github.com/crostream/widget-runtime/issues",
  "keywords": [
    "crostream",
    "widgets",
    "csw",
    "overlay",
    "streaming"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "crostream-widget": "bin/crostream-widget.mjs"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./tooling": {
      "types": "./dist/tooling/index.d.ts",
      "default": "./dist/tooling/index.js"
    },
    "./tooling/check": {
      "types": "./dist/tooling/check.d.ts",
      "default": "./dist/tooling/check.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "svelte": "./dist/render/index.js",
      "default": "./dist/render/index.js"
    },
    "./widget-frame.html": "./dist/widget-frame.html",
    "./contract.json": "./dist/contract.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "dev": "vite --config vite.dev.config.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "svelte": "^5"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
